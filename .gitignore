.metadata
bin/
tmp/
*.tmp
*.bak
*.swp
*~.nib
local.properties
.settings/
.loadpath
.recommenders


# External tool builders
.externalToolBuilders/


# Locally stored Eclipse launch configurations
*.launch


# PyDev specific
*.pydevproject


# CDT-specific
.cproject


# CDT autotools
.autotools


# Java annotation processor (APT)
.factorypath


# PDT-specific
.buildpath


# sbteclipse plugin
.target


# Tern plugin
.tern-project


# TeXlipse plugin
.texlipse


# STS (Spring Tool Suite)
.springBeans


# Code Recommenders
.recommenders/


# Annotation Processing
.apt_generated/
.apt_generated_tests/


# Scala IDE specific
.cache-main
.scala_dependencies
.worksheet


# Keep the Eclipse project description tracked.
# .project


# =========================================================
# JAVA
# =========================================================

# Compiled class files
*.class


# Log files
*.log


# BlueJ files
*.ctxt


# Mobile Tools for Java (J2ME)
.mtj.tmp/


# =========================================================
# PACKAGE FILES
# =========================================================

# Ignore package/archive files by default
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar


# =========================================================
# REQUIRED MOFFAT BAY LIBRARIES
# =========================================================

# The Moffat Bay web application requires this JDBC driver.
# Keep this specific JAR tracked so every team member receives
# the same MySQL connector when cloning or pulling the project.
!src/main/webapp/WEB-INF/lib/mysql-connector-j-26.7.0.jar


# =========================================================
# BUILD OUTPUT
# =========================================================

/build/


# =========================================================
# JVM CRASH FILES
# =========================================================

hs_err_pid*
replay_pid*


# =========================================================
# MACOS
# =========================================================

.DS_Store